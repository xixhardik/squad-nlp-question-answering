# =============================================================================
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.ckpt
*.h5
*.tflite
*.gguf
*.msgpack
checkpoint-*/
runs/

# =============================================================================
# Datasets & caches  (SQuAD is downloaded via the datasets library)
# =============================================================================
data/*
!data/.gitkeep
.cache/
hf_cache/
*.arrow
*.lock

# =============================================================================
# Experiment artifacts
# =============================================================================
# artifacts/ holds per-run checkpoints, tokenized caches and raw logs.
# It is machine-local. The small, reviewable metrics JSON is committed under
# reports/ instead - that is the project's evidence trail.
artifacts/*
!artifacts/.gitkeep

# models/ holds the selected checkpoint pulled down for local serving.
models/*
!models/.gitkeep

# Tracking tools
wandb/
mlruns/
lightning_logs/
tensorboard/
events.out.tfevents.*

