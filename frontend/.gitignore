# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example holds VARIABLE NAMES ONLY and must be version-controlled so the
# required configuration is discoverable. The template's blanket `.env*` rule
# above would otherwise hide it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
