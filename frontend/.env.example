# Frontend environment. Copy to `.env.local` (git-ignored) and adjust.
#
#   Windows PowerShell : Copy-Item .env.example .env.local
#   Linux / macOS      : cp .env.example .env.local
#
# Base URL of the FastAPI backend. Variables prefixed NEXT_PUBLIC_ are inlined
# into the client bundle at build time, so this must never hold a secret.
#
# There is no hard-coded localhost fallback in the source. If this is unset the
# UI reports that the API is not configured, rather than silently pointing at an
# address that only happens to work on one machine.
NEXT_PUBLIC_API_URL=http://localhost:8000
