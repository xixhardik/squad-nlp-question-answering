# https://editorconfig.org
# Keeps formatting consistent between the Windows dev machine and the
# Linux Lightning AI Studio.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,json,jsonc,css,scss,html,yml,yaml,md}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Windows batch / PowerShell need CRLF
[*.{bat,cmd,ps1}]
end_of_line = crlf
