# =============================================================================
# .env.example - VARIABLE NAMES ONLY. NEVER PUT REAL SECRETS IN THIS FILE.
# =============================================================================
# Copy to `.env` and fill in locally. `.env` is git-ignored.
#
#   Windows PowerShell : Copy-Item .env.example .env
#   Linux / macOS      : cp .env.example .env
#
# The test suite runs with zero configuration. For local serving, the only
# variable that matters is QAS_MODEL_PATH (backend) plus NEXT_PUBLIC_API_URL,
# which belongs in frontend/.env.local rather than here.
# =============================================================================

# --- Hugging Face -------------------------------------------------------------
# Only needed to UPLOAD a trained model. Downloading SQuAD and the public base
# checkpoints requires no token. Prefer `hf auth login` over storing it here.
HF_TOKEN=
HF_USERNAME=

# Target repo for the final trained model, e.g. <username>/<model-name>
MODEL_REPO=

# Redirect the Hugging Face cache (datasets + base models) off the system drive.
HF_HOME=

# --- ML / training ------------------------------------------------------------
# Device override. Leave empty for automatic resolution (cuda -> mps -> cpu).
# Accepted: cuda | cpu | mps
QAS_DEVICE=

# Override the artifacts root (per-run checkpoints, logs, tokenized caches).
QAS_ARTIFACTS_DIR=

# Global random seed override. Falls back to the value in ml/configs/base.yaml.
QAS_SEED=

# Silences the tokenizers fork warning when DataLoader workers are used.
TOKENIZERS_PARALLELISM=false

# --- Backend (FastAPI) --------------------------------------------------------
# Path to a local checkpoint directory OR a Hugging Face repo id.
#
# REQUIRED to serve predictions. Without it the service still starts and /health
# answers, but model_loaded is false and POST /predict returns 503. Read once at
# startup; a path that cannot be loaded fails startup loudly rather than being
# served as a silently broken model.
#
# Do NOT quote the value: pydantic-settings keeps the quotes as part of the string.
# Windows example (the space in the path is fine):
#   QAS_MODEL_PATH=D:\QAS NLP\models\deberta-v3-base-squad
#
# NOTE: this file is read relative to the PROCESS WORKING DIRECTORY, so start the
# backend from the repository root (see README "Local deployment").
QAS_MODEL_PATH=

# Comma-separated CORS allow-list for the Next.js dev server.
QAS_ALLOWED_ORIGINS=http://localhost:3000

QAS_LOG_LEVEL=INFO

# --- Frontend (Next.js) -------------------------------------------------------
# Base URL of the FastAPI backend. Must NOT be hard-coded in source.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Windows only -------------------------------------------------------------
# Prevents `UnicodeEncodeError: 'charmap' codec can't encode character '\u26a1'`
# when CLIs (lightning, hf, tqdm) emit non-cp1252 characters in PowerShell.
PYTHONIOENCODING=utf-8
