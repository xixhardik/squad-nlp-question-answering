# =============================================================================
# .env.example - VARIABLE NAMES ONLY. NEVER PUT REAL SECRETS IN THIS FILE.
# =============================================================================
# Copy to `.env` and fill in locally. `.env` is git-ignored.
#
#   Windows PowerShell : Copy-Item .env.example .env
#   Linux / macOS      : cp .env.example .env
#
# None of these are required for Phase 1. The Phase 1 backend and test suite
# run with zero configuration.
# =============================================================================

# --- Hugging Face -------------------------------------------------------------
# Only needed to UPLOAD a trained model. Downloading SQuAD and the public base
# checkpoints requires no token. Prefer `hf auth login` over storing it here.
HF_TOKEN=
HF_USERNAME=

# Target repo for the final trained model, e.g. <username>/<model-name>
MODEL_REPO=

# Redirect the Hugging Face cache (datasets + base models) off the system drive.
HF_HOME=

# --- ML / training ------------------------------------------------------------
# Device override. Leave empty for automatic resolution (cuda -> mps -> cpu).
# Accepted: cuda | cpu | mps
QAS_DEVICE=

# Override the artifacts root (per-run checkpoints, logs, tokenized caches).
QAS_ARTIFACTS_DIR=

# Global random seed override. Falls back to the value in ml/configs/base.yaml.
QAS_SEED=

# Silences the tokenizers fork warning when DataLoader workers are used.
TOKENIZERS_PARALLELISM=false

# --- Backend (FastAPI) --------------------------------------------------------
# Path to a local checkpoint directory OR a Hugging Face repo id.
# Unused in Phase 1 (no model is loaded yet).
QAS_MODEL_PATH=

# Comma-separated CORS allow-list for the Next.js dev server.
QAS_ALLOWED_ORIGINS=http://localhost:3000

QAS_LOG_LEVEL=INFO

# --- Frontend (Next.js) -------------------------------------------------------
# Base URL of the FastAPI backend. Must NOT be hard-coded in source.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Windows only -------------------------------------------------------------
# Prevents `UnicodeEncodeError: 'charmap' codec can't encode character '\u26a1'`
# when CLIs (lightning, hf, tqdm) emit non-cp1252 characters in PowerShell.
PYTHONIOENCODING=utf-8
